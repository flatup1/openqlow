<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  返信下書きルーティン（Phase 1: LINE公式のみ）。5分ごとに待ち行列を見る。

  この plist のままでは何もしない。中身を見て納得してから、順に有効にする。

    1. OPENQLOW_REPLY_DRAFT_ENABLED=true  下書きを作り始める（送信はしない）
    2. OPENQLOW_DRY_RUN=false             保存と通知を実際に行う

  送信する経路はコードに存在しない。お客様へは1文字も届かない。
  止めたいときは OPENQLOW_REPLY_DRAFT_DISABLED=true にして読み込み直す。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.flatup.openqlow.reply-draft</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd "/Users/jin/Desktop/OPENQLOW HelMES/openqlow" &amp;&amp; npm run reply-draft &gt;&gt; "$HOME/Library/Logs/openqlow-reply-draft.log" 2&gt;&amp;1</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jin/Desktop/OPENQLOW HelMES/openqlow</string>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/jin/Library/Logs/openqlow-reply-draft.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jin/Library/Logs/openqlow-reply-draft.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>

        <key>OPENQLOW_REPLY_DRAFT_SOURCES</key>
        <string>line</string>
        <key>OPENQLOW_REPLY_DRAFT_MAX_PER_RUN</key>
        <string>5</string>
        <key>OPENQLOW_REPLY_DRAFT_QUIET_HOURS</key>
        <string>22-7</string>

        <!-- ここから下が「実際に動かす」スイッチ。既定は全部オフ。 -->
        <key>OPENQLOW_REPLY_DRAFT_ENABLED</key>
        <string>false</string>
        <key>OPENQLOW_DRY_RUN</key>
        <string>true</string>
        <key>OPENQLOW_REPLY_DRAFT_DISABLED</key>
        <string>false</string>
    </dict>
</dict>
</plist>
