# OPENQLOW never publishes directly in Phase 1.
OPENQLOW_ROOT=/Users/jin/Desktop/OPENQLOW HelMES/openqlow
FLATUP_AI_OS_ROOT=/Users/jin/Desktop/OPENQLOW HelMES/flatup-ai-os
OBSIDIAN_VAULT_ROOT=/Users/jin/Documents/Obsidian Vault
OPENQLOW_INBOX_RELATIVE=30_INBOX/openqlow
OPENQLOW_LINE_PORT=8787
OPENQLOW_DRY_RUN=true
OPENQLOW_LINE_DRY_RUN=false
OPENQLOW_PUBLIC_WEBHOOK_URL=

# LLM
OPENROUTER_API_KEY=

# LINE webhook（Do not commit real secrets）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
JIN_LINE_USER_ID=
BACKUP_APPROVER_LINE_USER_ID=

# SNS 配信
THREADS_ACCESS_TOKEN=
IG_ACCESS_TOKEN=
FB_PAGE_TOKEN=
GOOGLE_BUSINESS_ACCESS_TOKEN=

# Typefully config is read from the existing local config, never stored here.
TYPEFULLY_CONFIG_PATH=/Users/jin/.config/typefully/config.json

# 退会の自動返信（既定は無効。OPENQLOW_DRY_RUN=false と両方揃って初めて会員へ届く）
OPENQLOW_WITHDRAWAL_AUTO_REPLY=false
# 退会操作の担当者名（監査ログに残る）
OPENQLOW_STAFF_NAME=

# ゴミ収集クリーンシステム（デスクトップ整頓・ゴミ箱・外付けバックアップ）
# 何も設定しなければ「お試し実行」。ファイルは1件も動かない。
OPENQLOW_CLEANUP_TARGETS=~/Desktop,~/Downloads
OPENQLOW_CLEANUP_ORGANIZED_ROOT=~/Desktop/00_整理済み
OPENQLOW_CLEANUP_QUARANTINE_ROOT=~/Desktop/99_ゴミ箱待ち
# 外付けドライブ（未接続なら自動でスキップ）
OPENQLOW_CLEANUP_BACKUP_ROOT=
OPENQLOW_CLEANUP_BACKUP_FOLDER=FLATUP_CLEAN
# 何日触っていないファイルを片づけるか
OPENQLOW_CLEANUP_IDLE_DAYS=1
# ゴミ箱待ちで何日保管してから完全削除するか
OPENQLOW_CLEANUP_RETENTION_DAYS=30
# true にして初めて実際にファイルが動く
OPENQLOW_CLEANUP_APPLY=false
# true にして初めて保管日数を過ぎたファイルを完全削除する
OPENQLOW_CLEANUP_PURGE=false
# true にして初めて Mac のゴミ箱の古いファイルを消す
OPENQLOW_CLEANUP_EMPTY_TRASH=false
OPENQLOW_CLEANUP_TRASH_ROOTS=~/.Trash
# フォルダごと整頓するか（既定はフォルダに触らない）
OPENQLOW_CLEANUP_INCLUDE_FOLDERS=false
# 緊急停止
OPENQLOW_CLEANUP_DISABLED=false
