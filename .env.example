# OPENQLOW never publishes directly in Phase 1.
OPENQLOW_ROOT=/Users/jin/Desktop/OPENQLOW HelMES/openqlow
FLATUP_AI_OS_ROOT=/Users/jin/Desktop/OPENQLOW HelMES/flatup-ai-os
OBSIDIAN_VAULT_ROOT=/Users/jin/Documents/Obsidian Vault
OPENQLOW_INBOX_RELATIVE=30_INBOX/openqlow
OPENQLOW_LINE_PORT=8787
OPENQLOW_DRY_RUN=true
OPENQLOW_LINE_DRY_RUN=false
OPENQLOW_PUBLIC_WEBHOOK_URL=

# LLM
OPENROUTER_API_KEY=

# LINE webhook（Do not commit real secrets）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
JIN_LINE_USER_ID=
BACKUP_APPROVER_LINE_USER_ID=

# 広告専用LINE（AIKA・会員対応LINEとは別アカウント／別資格情報）。
# @817nsdhr の旧openQLOW設定をこの専用レーンへ移す場合も、実値はこのファイルへ
# commitせず、ローカルまたはVPSの秘密設定だけに入れる。
AD_LINE_PURPOSE=advertising
AD_LINE_CHANNEL_ID=2008998149
AD_LINE_ACCOUNT_BASIC_ID=@817nsdhr
AD_LINE_CHANNEL_SECRET=
AD_LINE_CHANNEL_ACCESS_TOKEN=
AD_LINE_OWNER_USER_ID=
AD_LINE_WEBHOOK_PATH=/openqlow/ad-line/webhook
AD_LINE_PORT=8788
AD_LINE_DATA_DIR=
AD_LINE_DRY_RUN=true
# 広告日報は初期状態でファイル作成だけ。LINEへは送らない。
AD_LINE_REPORT_DRY_RUN=true
AD_LINE_REPORT_DISABLED=false
AD_LINE_REPORT_WRITE_FILE=true

# 混線防止チェック用。既存会員対応LINEの公開IDだけを設定する（秘密値は不要）。
MEMBER_LINE_CHANNEL_ID=
MEMBER_LINE_ACCOUNT_BASIC_ID=@jfl0054o

# SNS 配信
THREADS_ACCESS_TOKEN=
IG_ACCESS_TOKEN=
FB_PAGE_TOKEN=
GOOGLE_BUSINESS_ACCESS_TOKEN=

# Typefully config is read from the existing local config, never stored here.
TYPEFULLY_CONFIG_PATH=/Users/jin/.config/typefully/config.json
