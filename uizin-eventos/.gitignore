node_modules/
.next/
out/
.wrangler/
*.tsbuildinfo
.env
.env.local
# wrangler dev のローカル用シークレット。本番の操作キーは絶対に置かない
.dev.vars
worker/.dev.vars
# next build / next dev が自動生成する（.next/ 内の型を参照するため、追跡しない）
next-env.d.ts

# オフライン進行台本の出力。選手名・意気込みが入るのでコミットしない
out-offline/
out-private-pages/

# next dev が自動生成する案内文（コミットしない）。このフォルダの中の AGENTS.md / CLAUDE.md だけ。
# リポジトリのいちばん上にある AGENTS.md / CLAUDE.md は、別のファイル（追跡している）
/AGENTS.md
/CLAUDE.md

# 選手の写真は公開サイトへ配るだけ。リポジトリには入れない
public/photos/
public/_tmp_import/
# 注意: public/_headers は追跡している（公開の安全設定。CSP など）。ここに書いて無視しないこと

# 手元だけの作業フォルダ（ビルドの古いキャッシュ・点検用のコピー）。誤って git add しない
next-stale-cache*/
bd-*/
audit/
srv.pid

# verify-private-all.sh が全部合格したときに書く指紋（公開のコマンドが見る。コミットしない）
.verify-ok
