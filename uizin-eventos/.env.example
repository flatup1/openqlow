# 画面（Cloudflare Pages）のビルド時に使う設定
# Worker の公開URL。末尾のスラッシュは付けない。
NEXT_PUBLIC_EVENTOS_API=https://uizin-eventos-api.example.workers.dev

# --- 以下は Worker 側の設定。ここには書かず、wrangler で入れる ---
# npx wrangler secret put OPERATOR_KEY --config worker/wrangler.toml
# SHEET_ID は worker/wrangler.toml の [vars] に入れる（秘密ではないが公開リポジトリには置かない運用）
